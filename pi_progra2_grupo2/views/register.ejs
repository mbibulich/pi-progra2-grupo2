<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<%- include('partials/head') %>


<body>
<!-- Header -->
<% if (locals.user != null) { %>
	<%- include('partials/headerLogeado') %>
<% } else { %>
	<%- include('partials/headerNoLogeado') %>
<% } %>
<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Registrate</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<form action="/users/register" method="POST" class="col-12">
				<div class="form-group">
					<label for="name">Nombre:</label>
					<input type="text" id="name" name="name" class="form-control" value="<%= locals.old !== undefined && old.name ? old.name : '' %>">
					<% if (locals.errors && locals.errors.name.msg) { %>
						<p class="feedback"><%= locals.errors.name.msg %></p>
					<% } %>
				</div>
				<div class="form-group">
					<label for="email">Email:</label>
					<input type="email" id="email" name="email" class="form-control" value="<%= locals.old !== undefined && old.email ? old.email : '' %>">
					<% if (locals.errors && locals.errors.email.msg) { %>
						<p class="feedback"><%= locals.errors.email.msg %></p>
					<% } %>
				</div>
				<div class="form-group">
					<label for="password">Contraseña:</label>
					<input type="password" id="password" name="password" class="form-control">
					<% if (locals.errors && locals.errors.password.msg) { %>
						<p class="feedback"><%= locals.errors.password.msg %></p><% } %>
					
				</div>
				<button type="submit" class="btn btn-primary">Registrarse</button>
			</form>
		</div>
	</div>
	<!-- footer -->
	<%- include('partials/footer') %>

	<!-- /footer -->
</body>

</html>