<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<%- include('partials/head') %>


<body>
<!-- Header -->
<% if (locals.user != null) { %>
	<%- include('partials/headerLogeado') %>
<% } else { %>
	<%- include('partials/headerNoLogeado') %>
<% } %>
<!-- /Header -->

			<!-- Novedades -->
			<div class="container products-wrapper">
				<div class="row">
					<div class="col-12">
						<h2 class="products-title">Resultados de búsqueda</h2>
			</div>
			<% for( let i=0; i <product.length; i++ ) { %>
			<div class="col-12 col-sm-6 col-lg-3">
				<section class="product-box">
					<a href="/products/id/<%= product[i].idProducto %>">
						<article class="product-box_data">
							<h2><%= product[i].nombre %></h2>
							<p><%= product[i].descripcion %></p>
							<img src="/images/products/<%= product[i].fotoProducto %>" alt="<%= product[i].nombre %>">
						</article>
					</a>
				</section>
			</div>
			<% } %>
				</div>
			</div>

			<!-- footer -->
			<%- include('partials/footer') %>
				<!-- /footer -->
	</body>

</html>