<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include('partials/head') %>

<body>
<!-- Header -->
<% if (locals.user != undefined) { %>
	<%- include('partials/headerLogeado') %>
<% } else { %>
	<%- include('partials/headerNoLogeado') %>
<% } %>
<!-- /Header -->

	<!-- Datos del usuario -->
	<section class="info-usuario container products-wrapper">
		<div class="row">
			<div class="img-container offset-3 col-2">
				<img src="/images/users/<%= usuario.fotoPerfil %>" alt="foto de perfil" class="foto-perfil">
			</div>
			<div class="data-container col-6">
				<div class="d-flex align-items-center ">
					<h1 class="main-title"><%= usuario.nombre %></h1>
				</div>
				<div>
					<ul class="">
						<li><%= usuario.email %></li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<!-- /Datos del usuario -->

	<!-- Mis productos -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Mis productos (<%= usuario.productos.length %>)</h2>
			</div>

			<% if (usuario.productos.length > 0) { %>
				<% for(let i = 0; i < usuario.productos.length; i++) { %>
					<div class="col-12 col-sm-6 col-lg-3">
						<section class="product-box">
							<a href="/products/id/<%= usuario.productos[i].idProducto %>">
								<figure class="product-box_image">
									<img src="/images/products/<%=usuario.productos[i].fotoProducto %>" alt="<%= usuario.productos[i].nombre %>">
								</figure>

								<article class="product-box_data">
									<h2><%= usuario.productos[i].nombre %></h2>
									<p><%= usuario.productos[i].descripcion %></p>
								</article>
							</a>
						</section>
					</div>
				<% } %>
			<% } else { %>
				<p>Este usuario no tiene productos</p>
			<% } %>

		</div>
	</div>
	<!-- /Mis productos -->

	<!-- footer -->
	<%- include('partials/footer') %>

	<!-- /footer -->
</body>	
</html>